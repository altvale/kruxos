# Agent discovery — Link headers (RFC 8288)
/
  Link: </.well-known/api-catalog>; rel="api-catalog"
  Link: </llms.txt>; rel="service-doc"; type="text/plain"
  Link: </.well-known/openapi.json>; rel="service-desc"; type="application/json"
  Link: </.well-known/mcp/server-card.json>; rel="describedby"; type="application/json"
  Link: </.well-known/agent-skills/index.json>; rel="describedby"; type="application/json"
  Link: </auth.md>; rel="service-doc"; type="text/markdown"
  Link: <https://kruxos.com/agents/>; rel="service-doc"
  Link: <https://kruxos.com/llms.txt>; rel="service-doc"; type="text/plain"

/getting-started/
  Link: </llms.txt>; rel="service-doc"; type="text/plain"
  Link: </.well-known/api-catalog>; rel="api-catalog"

/quickstart/install/
  Link: </llms.txt>; rel="service-doc"; type="text/plain"
  Link: </auth.md>; rel="service-doc"; type="text/markdown"

/developers/api/*
  Link: </.well-known/openapi.json>; rel="service-desc"; type="application/json"
  Link: </.well-known/api-catalog>; rel="api-catalog"

/.well-known/api-catalog
  Content-Type: application/linkset+json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/openapi.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/oauth-authorization-server
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/oauth-protected-resource
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/openid-configuration
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/mcp/server-card.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/agent-skills/index.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/agent-skills/*/SKILL.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8

/auth.md
  Content-Type: text/markdown; charset=utf-8

/markdown/*
  Content-Type: text/markdown; charset=utf-8